# ==============================================================
# Vintisk Pharmaceuticals - Environment Configuration
# ==============================================================

# Server Port (Render sets PORT automatically, defaults to 3000 locally)
PORT=3000

# Environment mode ('production' or 'development')
NODE_ENV=production

# Admin Portal Authentication
# REQUIRED in production: Define secure credentials for the administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisToASecurePassword2026!

# Set to 'true' if you want to force-update the admin password from ADMIN_PASSWORD on restart
UPDATE_ADMIN_PASSWORD=false

# Persistent Storage Directory (Render Persistent Disk Mount Path)
# If using a Render Disk mounted at /var/data, set PERSISTENT_DATA_DIR=/var/data
# Locally, leave unset to default to ./data and ./storage
PERSISTENT_DATA_DIR=/var/data

# Optional: Restrict allowed CORS origins for external API clients
# CORS_ORIGIN=https://vintisk-pharma.onrender.com
